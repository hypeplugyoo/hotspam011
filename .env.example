NODE_ENV=development
APP_URL=http://localhost:3000
POSTGRES_PASSWORD=CHOOSE_A_LOCAL_PASSWORD
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_BROWSER_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=media
MINIO_ROOT_USER=CHOOSE_A_LOCAL_USER
MINIO_ROOT_PASSWORD=CHOOSE_A_LOCAL_PASSWORD
APP_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
SESSION_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_32_BYTE_BASE64_KEY
DEMO_MODE=true
PUBLISH_CONCURRENCY=1
ORG_CONCURRENCY=1
METRICS_POLL_INTERVAL_MINUTES=360
TZ=America/Sao_Paulo
